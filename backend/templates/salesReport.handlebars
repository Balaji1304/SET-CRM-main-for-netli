<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{reportInfo.reportName}}</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: 'Arial', sans-serif;
            line-height: 1.6;
            color: #333;
            background: #fff;
        }
        
        .container {
            max-width: 100%;
            margin: 0 auto;
            padding: 20px;
        }
        
        /* Header Styles */
        .header {
            text-align: center;
            border-bottom: 3px solid #2563eb;
            padding-bottom: 20px;
            margin-bottom: 30px;
        }
        
        .company-logo {
            font-size: 24px;
            font-weight: bold;
            color: #2563eb;
            margin-bottom: 10px;
        }
        
        .report-title {
            font-size: 28px;
            font-weight: bold;
            color: #1a1a1a;
            margin-bottom: 10px;
        }
        
        .report-subtitle {
            font-size: 16px;
            color: #666;
            margin-bottom: 5px;
        }
        
        .report-meta {
            font-size: 12px;
            color: #888;
            margin-top: 10px;
        }
        
        /* Section Styles */
        .section {
            margin-bottom: 30px;
            page-break-inside: avoid;
        }
        
        .section-title {
            font-size: 20px;
            font-weight: bold;
            color: #2563eb;
            border-bottom: 2px solid #e5e7eb;
            padding-bottom: 8px;
            margin-bottom: 15px;
        }
        
        .section-subtitle {
            font-size: 16px;
            font-weight: bold;
            color: #374151;
            margin-bottom: 10px;
        }
        
        /* KPI Grid */
        .kpi-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 15px;
            margin-bottom: 20px;
        }
        
        .kpi-card {
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            padding: 15px;
            text-align: center;
            background: #f9fafb;
        }
        
        .kpi-label {
            font-size: 12px;
            color: #6b7280;
            text-transform: uppercase;
            font-weight: 600;
            margin-bottom: 5px;
        }
        
        .kpi-value {
            font-size: 24px;
            font-weight: bold;
            color: #1f2937;
            margin-bottom: 5px;
        }
        
        .kpi-status {
            font-size: 10px;
            padding: 2px 8px;
            border-radius: 12px;
            font-weight: 600;
            text-transform: uppercase;
        }
        
        .status-excellent { background: #10b981; color: white; }
        .status-good { background: #3b82f6; color: white; }
        .status-average { background: #f59e0b; color: white; }
        .status-poor { background: #ef4444; color: white; }
        
        /* Tables */
        .data-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 20px;
            font-size: 12px;
        }
        
        .data-table th {
            background: #f3f4f6;
            color: #374151;
            font-weight: 600;
            padding: 10px 8px;
            text-align: left;
            border: 1px solid #e5e7eb;
        }
        
        .data-table td {
            padding: 8px;
            border: 1px solid #e5e7eb;
            vertical-align: top;
        }
        
        .data-table tr:nth-child(even) {
            background: #f9fafb;
        }
        
        .text-right { text-align: right; }
        .text-center { text-align: center; }
        .font-bold { font-weight: bold; }
        
        /* Performance Indicators */
        .performance-excellent { color: #10b981; font-weight: bold; }
        .performance-good { color: #3b82f6; font-weight: bold; }
        .performance-average { color: #f59e0b; font-weight: bold; }
        .performance-poor { color: #ef4444; font-weight: bold; }
        
        /* Two Column Layout */
        .two-column {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 20px;
        }
        
        /* Comparison Cards */
        .comparison-card {
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            padding: 15px;
            background: #f9fafb;
        }
        
        .comparison-title {
            font-size: 14px;
            font-weight: bold;
            color: #374151;
            margin-bottom: 10px;
        }
        
        .comparison-item {
            display: flex;
            justify-content: space-between;
            margin-bottom: 5px;
            font-size: 12px;
        }
        
        .change-positive { color: #10b981; font-weight: bold; }
        .change-negative { color: #ef4444; font-weight: bold; }
        .change-neutral { color: #6b7280; }
        
        /* Summary Box */
        .summary-box {
            background: #f0f9ff;
            border: 1px solid #0ea5e9;
            border-radius: 8px;
            padding: 20px;
            margin-bottom: 20px;
        }
        
        .summary-title {
            font-size: 16px;
            font-weight: bold;
            color: #0369a1;
            margin-bottom: 10px;
        }
        
        .summary-content {
            font-size: 14px;
            color: #374151;
            line-height: 1.6;
        }
        
        /* Recommendations */
        .recommendation {
            background: #fef3c7;
            border-left: 4px solid #f59e0b;
            padding: 12px;
            margin-bottom: 10px;
            font-size: 12px;
        }
        
        .recommendation-type {
            font-weight: bold;
            color: #92400e;
        }
        
        .recommendation-priority {
            font-size: 10px;
            background: #f59e0b;
            color: white;
            padding: 2px 6px;
            border-radius: 10px;
            margin-left: 5px;
        }
        
        /* Footer */
        .footer {
            margin-top: 40px;
            padding-top: 20px;
            border-top: 1px solid #e5e7eb;
            text-align: center;
            font-size: 10px;
            color: #6b7280;
        }
        
        /* Page Break */
        .page-break {
            page-break-before: always;
        }
        
        /* Print Specific */
        @media print {
            body { font-size: 12px; }
            .section { margin-bottom: 20px; }
            .kpi-grid { grid-template-columns: repeat(2, 1fr); }
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Header Section -->
        <div class="header">
            <div class="company-logo">SUNLIT CRM</div>
            <h1 class="report-title">{{reportInfo.reportName}}</h1>
            <div class="report-subtitle">{{reportInfo.reportType}} | {{reportInfo.period.type}}</div>
            <div class="report-meta">
                Period: {{reportInfo.period.start}} to {{reportInfo.period.end}} | 
                Generated: {{reportInfo.generatedDate}} | 
                Generated By: {{reportInfo.generatedBy}}
                {{#if reportInfo.generatedFor}}| For: {{reportInfo.generatedFor}}{{/if}}
            </div>
        </div>

        <!-- Executive Summary -->
        <div class="section">
            <h2 class="section-title">📊 Executive Summary</h2>
            <div class="summary-box">
                <div class="summary-title">Performance Overview</div>
                <div class="summary-content">
                    During the reporting period, {{kpis.totalLeads}} leads were managed with a conversion rate of {{kpis.conversionRate}}. 
                    Total revenue generated was {{kpis.totalRevenue}} through {{kpis.convertedLeads}} successful conversions. 
                    The quotation success rate stood at {{kpis.quotationSuccessRate}} with {{kpis.approvedQuotations}} approved quotations 
                    out of {{kpis.totalQuotations}} total quotations submitted.
                    {{#if performanceSummary.overallRating}}
                    <br><br><strong>Overall Performance Rating: {{performanceSummary.overallRating}}</strong>
                    {{/if}}
                </div>
            </div>
        </div>

        <!-- Key Performance Indicators -->
        <div class="section">
            <h2 class="section-title">🎯 Key Performance Indicators</h2>
            <div class="kpi-grid">
                <div class="kpi-card">
                    <div class="kpi-label">Total Leads</div>
                    <div class="kpi-value">{{kpis.totalLeads}}</div>
                </div>
                <div class="kpi-card">
                    <div class="kpi-label">Conversion Rate</div>
                    <div class="kpi-value">{{kpis.conversionRate}}</div>
                </div>
                <div class="kpi-card">
                    <div class="kpi-label">Total Revenue</div>
                    <div class="kpi-value">{{kpis.totalRevenue}}</div>
                </div>
                <div class="kpi-card">
                    <div class="kpi-label">Total Quotations</div>
                    <div class="kpi-value">{{kpis.totalQuotations}}</div>
                </div>
                <div class="kpi-card">
                    <div class="kpi-label">Quotation Success</div>
                    <div class="kpi-value">{{kpis.quotationSuccessRate}}</div>
                </div>
                <div class="kpi-card">
                    <div class="kpi-label">Average Deal Size</div>
                    <div class="kpi-value">{{kpis.averageDealSize}}</div>
                </div>
            </div>
        </div>

        <!-- Lead Source Analysis -->
        {{#if leadSources.length}}
        <div class="section">
            <h2 class="section-title">📍 Lead Source Analysis</h2>
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Lead Source</th>
                        <th class="text-right">Count</th>
                        <th class="text-right">Percentage</th>
                        <th class="text-right">Conversion Rate</th>
                        <th class="text-center">Performance</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each leadSources}}
                    <tr>
                        <td class="font-bold">{{this.source}}</td>
                        <td class="text-right">{{this.count}}</td>
                        <td class="text-right">{{this.percentage}}</td>
                        <td class="text-right">{{this.conversionRate}}</td>
                        <td class="text-center performance-{{this.status}}">{{this.status}}</td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
        {{/if}}

        <!-- Product Performance -->
        {{#if productPerformance.length}}
        <div class="section">
            <h2 class="section-title">🏆 Product Performance</h2>
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Product Name</th>
                        <th class="text-right">Quotations</th>
                        <th class="text-right">Sales</th>
                        <th class="text-right">Revenue</th>
                        <th class="text-right">Success Rate</th>
                        <th class="text-center">Performance</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each productPerformance}}
                    <tr>
                        <td class="font-bold">{{this.productName}}</td>
                        <td class="text-right">{{this.quotations}}</td>
                        <td class="text-right">{{this.sales}}</td>
                        <td class="text-right">{{this.revenue}}</td>
                        <td class="text-right">{{this.successRate}}</td>
                        <td class="text-center performance-{{this.status}}">{{this.status}}</td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
        {{/if}}

        <!-- Customer Segmentation -->
        {{#if customerSegmentation.length}}
        <div class="section">
            <h2 class="section-title">👥 Customer Segmentation</h2>
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Segment</th>
                        <th class="text-right">Count</th>
                        <th class="text-right">Percentage</th>
                        <th class="text-right">Average Value</th>
                        <th class="text-center">Priority</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each customerSegmentation}}
                    <tr>
                        <td class="font-bold">{{this.segment}}</td>
                        <td class="text-right">{{this.count}}</td>
                        <td class="text-right">{{this.percentage}}</td>
                        <td class="text-right">{{this.averageValue}}</td>
                        <td class="text-center">{{this.priority}}</td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
        {{/if}}

        <!-- Page Break -->
        <div class="page-break"></div>

        <!-- Comparative Analysis -->
        <div class="section">
            <h2 class="section-title">📈 Comparative Analysis</h2>
            <div class="two-column">
                <div class="comparison-card">
                    <div class="comparison-title">Previous Period Comparison</div>
                    <div class="comparison-item">
                        <span>Revenue:</span>
                        <span>{{comparison.previousPeriod.revenue}} 
                            <span class="change-{{comparison.previousPeriod.changeStatus}}">
                                ({{comparison.previousPeriod.change}})
                            </span>
                        </span>
                    </div>
                    <div class="comparison-item">
                        <span>Leads:</span>
                        <span>{{comparison.previousPeriod.leads}}</span>
                    </div>
                    <div class="comparison-item">
                        <span>Conversion Rate:</span>
                        <span>{{comparison.previousPeriod.conversionRate}}</span>
                    </div>
                </div>
                
                <div class="comparison-card">
                    <div class="comparison-title">Target Achievement</div>
                    <div class="comparison-item">
                        <span>Revenue Target:</span>
                        <span>{{comparison.targets.revenueTarget}}</span>
                    </div>
                    <div class="comparison-item">
                        <span>Achievement:</span>
                        <span class="change-{{comparison.targets.achievementStatus}}">
                            {{comparison.targets.achievement}}
                        </span>
                    </div>
                    <div class="comparison-item">
                        <span>Leads Target:</span>
                        <span>{{comparison.targets.leadsTarget}}</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Time Analysis -->
        {{#if timeAnalysis}}
        <div class="section">
            <h2 class="section-title">⏱️ Time Analysis</h2>
            <div class="two-column">
                <div class="comparison-card">
                    <div class="comparison-title">Response Metrics</div>
                    <div class="comparison-item">
                        <span>Avg Response Time:</span>
                        <span class="performance-{{timeAnalysis.responseTimeStatus}}">
                            {{timeAnalysis.avgResponseTime}}
                        </span>
                    </div>
                    <div class="comparison-item">
                        <span>Avg Sales Cycle:</span>
                        <span class="performance-{{timeAnalysis.salesCycleStatus}}">
                            {{timeAnalysis.avgSalesCycle}}
                        </span>
                    </div>
                </div>
                
                <div class="comparison-card">
                    <div class="comparison-title">Activity Patterns</div>
                    <div class="comparison-item">
                        <span>Peak Hours:</span>
                        <span>{{timeAnalysis.peakHours}}</span>
                    </div>
                    <div class="comparison-item">
                        <span>Peak Days:</span>
                        <span>{{timeAnalysis.peakDays}}</span>
                    </div>
                </div>
            </div>
        </div>
        {{/if}}

        <!-- Recent Trends -->
        {{#if trends.hasTrendData}}
        <div class="section">
            <h2 class="section-title">📊 Recent Daily Trends</h2>
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th class="text-right">Leads</th>
                        <th class="text-right">Quotations</th>
                        <th class="text-right">Sales</th>
                        <th class="text-right">Revenue</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each trends.recentDaily}}
                    <tr>
                        <td>{{this.date}}</td>
                        <td class="text-right">{{this.leads}}</td>
                        <td class="text-right">{{this.quotations}}</td>
                        <td class="text-right">{{this.sales}}</td>
                        <td class="text-right">{{this.revenue}}</td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
        {{/if}}

        <!-- Recommendations -->
        {{#if recommendations.length}}
        <div class="section">
            <h2 class="section-title">💡 Recommendations</h2>
            {{#each recommendations}}
            <div class="recommendation">
                <span class="recommendation-type">{{this.type}}</span>
                <span class="recommendation-priority">{{this.priority}}</span>
                <br>{{this.recommendation}}
            </div>
            {{/each}}
        </div>
        {{/if}}

        <!-- Strengths and Improvements -->
        {{#if performanceSummary}}
        <div class="section">
            <h2 class="section-title">🔍 Performance Summary</h2>
            <div class="two-column">
                {{#if performanceSummary.strengths.length}}
                <div class="comparison-card">
                    <div class="comparison-title">✅ Key Strengths</div>
                    {{#each performanceSummary.strengths}}
                    <div class="comparison-item">
                        <span>• {{this}}</span>
                    </div>
                    {{/each}}
                </div>
                {{/if}}
                
                {{#if performanceSummary.improvements.length}}
                <div class="comparison-card">
                    <div class="comparison-title">🎯 Areas for Improvement</div>
                    {{#each performanceSummary.improvements}}
                    <div class="comparison-item">
                        <span>• {{this}}</span>
                    </div>
                    {{/each}}
                </div>
                {{/if}}
            </div>
        </div>
        {{/if}}

        <!-- Footer -->
        <div class="footer">
            <p>Report ID: {{reportInfo.reportId}} | Generated on {{reportInfo.timestamp}} | Sunlit CRM Analytics</p>
            <p>This report contains confidential business information. Distribution should be limited to authorized personnel only.</p>
        </div>
    </div>
</body>
</html>

