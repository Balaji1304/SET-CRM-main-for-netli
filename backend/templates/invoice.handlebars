<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>Proforma Invoice - {{invoiceNumber}}</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      line-height: 1.6;
      color: #333;
      margin: 0;
      padding: 0;
      background-color: #fff;
    }
    .invoice-container {
      max-width: 800px;
      margin: 20px auto;
      padding: 20px;
      background-color: #fff;
      border: 1px solid #ddd;
    }

    .header-section {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 30px;
      padding-bottom: 20px;
      border-bottom: 1px solid #eee;
    }
    .company-logo-header img {
      max-height: 50px;
      width: auto;
      object-fit: contain;
      margin-bottom: 10px;
    }
    .company-details-header {
      font-size: 0.9rem;
    }
    .company-details-header h1 {
      font-size: 1.5rem;
      font-weight: bold;
      color: #000;
      margin: 0 0 5px 0;
    }
    .company-details-header p {
      font-size: 0.85rem;
      color: #555;
      margin: 0;
      white-space: pre-line;
    }
    .invoice-info-header {
      text-align: right;
    }
    .invoice-info-header h2 {
      font-size: 1.6rem;
      font-weight: bold;
      color: #000;
      margin: 0 0 10px 0;
      text-transform: uppercase;
    }
    .invoice-info-header p {
      font-size: 0.85rem;
      color: #555;
      margin: 3px 0;
    }

    .customer-deliver-section {
      display: flex;
      justify-content: space-between;
      margin-bottom: 30px;
      gap: 20px;
    }
    .contact-block {
      flex: 1;
      background-color: #f9f9f9;
      padding: 15px;
      border-radius: 6px;
      border: 1px solid #eee;
    }
    .contact-block h3 {
      font-size: 0.9rem;
      font-weight: 600;
      color: #374151;
      margin-top: 0;
      margin-bottom: 10px;
    }
    .contact-block p {
      font-size: 0.85rem;
      color: #4b5563;
      margin: 4px 0;
      white-space: pre-line;
    }
    .contact-block p .text-bold {
        font-weight: 600;
    }

    .order-details-section h3 {
      font-size: 1rem;
      font-weight: bold;
      color: #888;
      margin-top: 0;
      margin-bottom: 10px;
      text-transform: uppercase;
    }

    .items-table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 30px;
      font-size: 0.85rem;
    }
    .items-table th, .items-table td {
      padding: 8px;
      text-align: left;
      border-bottom: 1px solid #eee;
    }
    .items-table thead tr {
      background-color: #f5f5f5;
      color: #333;
    }
    .items-table th {
      font-weight: bold;
    }
    .items-table tbody tr:last-child td {
      border-bottom: none;
    }
    .items-table .text-right {
      text-align: right;
    }
    .items-table .text-center {
        text-align: center;
    }
    .items-table .item-name {
        font-weight: bold;
    }
    .items-table .item-description {
        font-size: 0.8rem;
        color: #666;
        padding-left: 10px;
        display: block;
    }

    .totals-section-right {
      display: flex;
      justify-content: flex-end;
      margin-bottom: 30px;
    }
    .totals-summary-box {
      width: 45%;
      min-width: 280px;
      font-size: 0.85rem;
    }
    .totals-summary-box .summary-row {
      display: flex;
      justify-content: space-between;
      padding: 6px 0;
      border-bottom: 1px solid #f0f0f0;
    }
    .totals-summary-box .summary-row:last-child {
      border-bottom: none;
    }
    .totals-summary-box .summary-label {
      color: #333;
    }
    .totals-summary-box .summary-value {
      color: #000;
      font-weight: bold;
    }
    .totals-summary-box .grand-total-row {
        border-top: 2px solid #ccc;
        margin-top: 5px;
        padding-top: 8px;
    }
    .totals-summary-box .grand-total-row .summary-label,
    .totals-summary-box .grand-total-row .summary-value {
      font-weight: bold;
      color: #d9534f;
      font-size: 0.9rem;
    }
    .totals-summary-box .summary-value.amount-paid-value {
        color: #16a34a;
    }

    .status-paid {
      color: #059669;
      background-color: #d1fae5;
      padding: 3px 10px;
      border-radius: 16px;
      font-size: 0.8rem;
      font-weight: 600;
      display: inline-block;
      line-height: 1.2;
    }
    .status-pending {
      color: #d97706;
      background-color: #ffedd5;
      padding: 2px 8px;
      border-radius: 9999px;
      font-size: 0.75rem;
      font-weight: 500;
      display: inline-block;
    }

    .footer-details {
      border-top: 1px solid #eee;
      padding-top: 20px;
      font-size: 0.8rem;
      color: #777;
      text-align: left;
    }
    .footer-details img.footer-logo {
        max-height: 30px;
        margin-bottom: 10px;
        display: block;
    }
    .footer-details p {
      margin: 3px 0;
      line-height: 1.4;
      overflow-wrap: break-word;
      word-break: break-word;
    }
    .footer-section-columns {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 15px;
    }
    .footer-column {
        flex: 1;
    }
    .footer-center-text {
        text-align: center;
        margin-top: 15px;
        padding-top: 10px;
        border-top: 1px solid #eee;
    }

    .text-bold { font-weight: bold; }

  </style>
</head>
<body>
  <div class="invoice-container">
    <div class="header-section">
        <div class="company-details-header">
          {{#if companyDetails.logoUrl}}
          <div class="company-logo-header">
            <img src="{{companyDetails.logoUrl}}" alt="{{companyDetails.name}} Logo">
          </div>
          {{/if}}
          <h1 class="text-bold">{{companyDetails.name}}</h1>
          <p>{{companyDetails.address}}</p>
        </div>
        <div class="invoice-info-header">
          <h2>PROFORMA INVOICE</h2>
          <p><span class="text-bold">Proforma Invoice No:</span> {{invoiceNumber}}</p>
          <p><span class="text-bold">Date Issued:</span> {{formatDate issueDate}}</p>
        </div>
    </div>

    <div class="customer-deliver-section">
      <div class="contact-block">
        <h3>From:</h3>
        <p class="text-bold">{{companyDetails.name}}</p>
        <p>{{companyDetails.address}}</p>
        {{#if companyDetails.phone}}<p><span class="text-bold">Phone:</span> {{companyDetails.phone}}</p>{{/if}}
        {{#if companyDetails.email}}<p><span class="text-bold">Email:</span> {{companyDetails.email}}</p>{{/if}}
        {{#if companyDetails.taxId}}<p><span class="text-bold">Tax ID:</span> {{companyDetails.taxId}}</p>{{/if}}
      </div>
      <div class="contact-block">
        <h3>Bill To:</h3>
        <p class="text-bold">{{#if customerDetails.name}}{{customerDetails.name}}{{else}}Customer{{/if}}</p>
        <p>{{customerDetails.billingAddress}}</p>
        {{#if customerDetails.phone}}<p><span class="text-bold">Phone:</span> {{customerDetails.phone}}</p>{{/if}}
        {{#if customerDetails.email}}<p><span class="text-bold">Email:</span> {{customerDetails.email}}</p>{{/if}}
      </div>
    </div>

    <div class="order-details-section">
        <h3>Order Details</h3>
        <table class="items-table">
        <thead>
            <tr>
                <th>Item</th>
                <th class="text-center">Qty</th>
                <th class="text-right">Unit Price</th>
                <th class="text-right">Discount</th>
                <th class="text-right">Amount</th>
            </tr>
        </thead>
        <tbody>
            {{#each items}}
            <tr>
                <td>
                    <div class="item-name">{{name}}</div>
                    {{#if description}}<span class="item-description">{{description}}</span>{{/if}}
                </td>
                <td class="text-center">{{quantity}}</td>
                <td class="text-right">{{formatCurrency unitPrice}}</td>
                <td class="text-right">{{discountPercentage}}%</td>
                <td class="text-right">{{formatCurrency itemTotal}}</td>
            </tr>
            {{/each}}
        </tbody>
        </table>
    </div>

    <div class="totals-section-right">
      <div class="totals-summary-box">
        <div class="summary-row grand-total-row">
          <span class="summary-label">Total Amount:</span>
          <span class="summary-value">{{formatCurrency totalAmount}}</span>
        </div>
        <div class="summary-row">
          <span class="summary-label">Amount Paid:</span>
          <span class="summary-value amount-paid-value">{{formatCurrency paidAmount}}</span>
        </div>
        <div class="summary-row">
          <span class="summary-label">Status:</span>
          <span class="summary-value">
            {{#if (eq paymentStatus "PAID")}} 
              <span class="status-paid">PAID</span>
            {{else if (eq paymentStatus "PARTIALLY_PAID")}}
              <span class="status-pending">PARTIALLY PAID</span>
            {{else}}
              <span class="status-pending">{{paymentStatus}}</span>
            {{/if}}
          </span>
        </div>
      </div>
    </div>

    <div class="footer-details">
        {{#if companyDetails.logoUrl}}
            <img src="{{companyDetails.logoUrl}}" alt="{{companyDetails.name}} Logo" class="footer-logo">
        {{/if}}
        <p class="text-bold">{{companyDetails.name}}</p>
        
        <div class="footer-section-columns">
            <div class="footer-column">
                {{#if quotation.quotationNumber}}<p><strong>Quotation Ref:</strong> {{quotation.quotationNumber}}</p>{{/if}}
                {{#if customerPurchase.purchaseID}}<p><strong>Purchase ID:</strong> {{customerPurchase.purchaseID}}</p>{{/if}}
                {{#if customerPurchase.purchaseDate}}<p><strong>Purchase Date:</strong> {{formatDate customerPurchase.purchaseDate}}</p>{{/if}}
            </div>
            <div class="footer-column" style="text-align: right;">
                <p>Thank you for your business!</p>
            </div>
        </div>

        <div class="footer-center-text">
            <p><strong>Note:</strong> This is a Proforma Invoice for reference only. Official invoice will be provided separately.</p>
            <p>Proforma Invoice generated by {{companyDetails.name}} CRM System.</p>
            {{#if companyDetails.email}}
            <p>For questions, contact {{companyDetails.email}}{{#if companyDetails.phone}} or {{companyDetails.phone}}{{/if}}.</p>
            {{else if companyDetails.phone}}
            <p>For questions, contact {{companyDetails.phone}}.</p>
            {{/if}}
        </div>
    </div>

  </div>
</body>
</html> 