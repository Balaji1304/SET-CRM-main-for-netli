# Copy to backend/.env and fill in. Never commit the real .env.

NODE_ENV=development
PORT=5000

# Local MongoDB (or your Atlas connection string)
MONGODB_URI=mongodb://127.0.0.1:27017/solar-crm

# Required: at least 32 random characters, e.g. `openssl rand -hex 32`
JWT_SECRET=
JWT_EXPIRE=7d

FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# Razorpay (test keys locally)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=
FROM_NAME=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# WhatsApp Cloud API
WHATSAPP_DEV_MODE=true
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WABA_ID=
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_SYSTEM_USER_ID=

# Business details used in documents
BUSINESS_NAME=
BUSINESS_EMAIL=
BUSINESS_PHONE=
BUSINESS_ADDRESS=
COMPANY_LOGO_URL=
