    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "html2pdf.js": "^0.10.3",
    "lucide-react": "^0.294.0",
    "next-themes": "^0.2.1",
    "postcss": "^8.4.31",
    "react": "^18.2.0",
    "react-beautiful-dnd": "^13.1.1",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.54.2",
